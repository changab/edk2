#string STR_MODULE_ABSTRACT             #language en-US "BrotliCustomCompressLib compresses data using the BROTLI custom format."

#string STR_MODULE_DESCRIPTION          #language en-US "It mirrors the scratch allocator and header layout used by BrotliCustomDecompressLib."
